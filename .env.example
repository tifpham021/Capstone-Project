# Copy this file to .env.local and fill in the IDs to enable social sign-in.
# If a value is empty, that sign-in button explains what is missing instead of opening a popup.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Add http://localhost:5173 to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra admin center > App registrations > New registration.
# Add a "Single-page application" redirect URI: http://localhost:5173/auth-redirect.html
VITE_MICROSOFT_CLIENT_ID=
# "common" allows work, school, and personal Microsoft accounts.
VITE_MICROSOFT_TENANT_ID=common

# ReturnScan backend: AI identification plus the orders/returns database
# (defaults to http://127.0.0.1:8000).
# This URL is public browser configuration; do not include API keys here.
VITE_AI_API_BASE=http://127.0.0.1:8000

# Which UI to show: "desktop" (computer workstation) or "touch" (Raspberry Pi touchscreen).
# Defaults to desktop. You can override it in the browser with ?ui=touch or ?ui=desktop
# (remembered in that browser); ?ui=default goes back to this setting.
VITE_UI_MODE=desktop
