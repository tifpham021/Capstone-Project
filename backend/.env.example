# Variables are read from the PROCESS environment. Export them before starting
# uvicorn, or pass --env-file backend/.env (python-dotenv is in uvicorn[standard]).
RETURNSCAN_DECISION_ENGINE=luna
OPENAI_API_KEY=
RETURNSCAN_OPENAI_MODEL=gpt-6-luna
RETURNSCAN_OPENAI_REASONING=none
# Optional legacy local engine: cv (requires requirements-cv.txt).
RETURNSCAN_DEVICE=auto
RETURNSCAN_DATA_DIR=backend/.runtime
RETURNSCAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a long, random key before exposing the server beyond localhost.
RETURNSCAN_API_KEY=
# Optional persistent model cache / pre-downloaded trusted DINOv2 source:
# RETURNSCAN_MODEL_CACHE=/absolute/path/to/model-cache
# RETURNSCAN_DINO_SOURCE=/absolute/path/to/dinov2

# Raspberry Pi: process available camera views once they become still.
RETURNSCAN_CAMERAS_ENABLED=0
# One or two IDs; unavailable cameras are skipped if another can start.
RETURNSCAN_CAMERA_IDS=0,1
RETURNSCAN_CAMERA_SETTLE_SECONDS=2
RETURNSCAN_CAMERA_INTERVAL_SECONDS=0.2
RETURNSCAN_CAMERA_MOTION_FRACTION=0.015
RETURNSCAN_CAMERA_LOCAL_BACKEND=sift
# Optional expected catalog product; omit for automatic retrieval:
# RETURNSCAN_CAMERA_PRODUCT_ID=drill-model-a
# Set 0 for button-only capture from the frontend; 1 also scans on stillness.
RETURNSCAN_CAMERA_AUTO_SCAN=1

# Rectangle foreground alignment (default); features retains ALIKED/SIFT matching.
RETURNSCAN_ALIGNMENT_METHOD=rectangle
